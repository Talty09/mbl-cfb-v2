{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mbl",
  "main": "api/src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],

  // Serve on mbl.tom-talty.workers.dev. Set explicitly because the subdomain was
  // toggled off in the dashboard, and the config has to win over that.
  "workers_dev": true,

  // The Angular SPA is served straight from the assets binding. Asset requests
  // that don't invoke the Worker aren't billed as Worker requests, which is
  // what keeps us clear of the free plan's 100k requests/day ceiling.
  "assets": {
    "directory": "./web/dist/most-baller-league/browser",
    "binding": "ASSETS",
    // Deep links like /standings must serve index.html, not 404.
    "not_found_handling": "single-page-application",
    // Without this, the asset handler answers first and /api/* never reaches Hono.
    //
    // Note that `wrangler dev --test-scheduled` is not usable here: its
    // /__scheduled hook is unreachable behind the SPA fallback, and the fetch
    // handler forwards every non-/api path to ASSETS anyway. The cron is covered
    // by calling the scheduled handler directly in index.test.ts, and a slice can
    // be forced in a running app via POST /api/admin/sync.
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mbl",
      // From `wrangler d1 create mbl` (2026-08-05). Not a secret: the database is
      // only reachable with account credentials.
      "database_id": "32c2c555-e6b0-447b-99c6-847e596bf5be",
      "migrations_dir": "api/migrations"
    }
  ],

  // CFBD ingest. Each firing handles one slice (see services/ingest) because a
  // scheduled handler gets the same 10 ms CPU budget as any request. Five
  // minutes keeps Saturday scoreboards live enough for the design's pulsing
  // in-progress cards, at ~288 invocations/day.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  "vars": {
    "CURRENT_SEASON": "2026"
  },

  // Secrets are set with `wrangler secret put` and live in .dev.vars locally:
  //   CFBD_API_KEY

  "observability": {
    "enabled": true
  }
}
