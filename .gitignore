# Dependencies
node_modules/

# Environment / secrets
.env
.env.local
.dev.vars
.dev.vars.local

# Build output
dist/
out-tsc/
# Scratch Angular builds used to typecheck templates without clobbering dist/
dist-check-*/

# Cloudflare
.wrangler/
# worker-configuration.d.ts IS committed on purpose: it's generated from
# wrangler.jsonc by `npm run cf-typegen`, and committing it means typechecking
# and CI don't have to run wrangler first. Regenerate after changing bindings.

# Generated seed SQL — contains password hashes, rebuild with `npm run seed:build`
api/seeds/managers.sql

# Logs
*.log
npm-debug.log*

# Editor/OS
.DS_Store
Thumbs.db

# Angular
web/.angular/
