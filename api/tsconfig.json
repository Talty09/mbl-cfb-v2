{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    // vitest-pool-workers/types declares the `cloudflare:test` module used by
    // the integration tests (env bindings, applyD1Migrations).
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers/types"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "paths": {
      "shared": ["../shared/src/index.ts"],
      // Kept off the main barrel so zod never reaches the client bundle.
      "shared/requests": ["../shared/src/requests.ts"]
    }
  },
  // Worker code only. The scripts/ folder runs in Node and is checked by
  // tsconfig.scripts.json, so that Node globals cannot leak in here and
  // typecheck clean against a runtime that doesn't have them.
  "include": [
    "src/**/*.ts",
    "../shared/src/**/*.ts",
    // Generated by `npm run cf-typegen`; declares the Cloudflare.Env bindings.
    "../worker-configuration.d.ts"
  ]
}
