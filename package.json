{
  "name": "mbl",
  "private": true,
  "version": "2.0.0",
  "description": "Most Baller League — fantasy college football on Cloudflare Workers + D1",
  "workspaces": ["shared", "api", "web"],
  "packageManager": "npm@11.12.1",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "wrangler dev",
    "dev:web": "npm start -w web",
    "build": "npm run build -w web",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "cf-typegen": "wrangler types",

    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply mbl --local",
    "db:migrate:remote": "wrangler d1 migrations apply mbl --remote",
    "db:studio": "drizzle-kit studio",

    "bench-password": "tsx api/scripts/bench-password.ts",
    "seed:build": "tsx api/scripts/make-seed.ts",
    "seed:local": "wrangler d1 execute mbl --local --file=api/seeds/managers.sql",
    "seed:remote": "wrangler d1 execute mbl --remote --file=api/seeds/managers.sql",
    "make-password": "tsx api/scripts/make-password.ts"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^28.1.0",
    "tsx": "^4.23.1",
    "typescript": "~5.9.2",
    "wrangler": "^4.115.0"
  }
}
