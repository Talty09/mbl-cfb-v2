generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Pooled connection for queries. On Supabase use the pooler URL
  // (port 6543, ?pgbouncer=true); locally this is just the plain URL.
  url      = env("DATABASE_URL")
  // Direct (non-pooled) connection for migrations. On Supabase use port 5432;
  // locally set it to the same value as DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

model User {
  id             String  @id @default(uuid()) @map("user_id")
  email          String  @unique
  passwordHash   String? @map("password_hash")
  firstName      String  @map("first_name")
  lastName       String  @map("last_name")
  displayName    String  @map("display_name")
  // Hue (0-360) for the manager's oklch avatar color per the design handoff
  avatarHue      Int     @default(0) @map("avatar_hue")
  isCommissioner Boolean @default(false) @map("is_commissioner")

  rosterSpots RosterSpot[]
  draftSlots  DraftSlot[]
  draftPicks  DraftPick[]
  messages    ChatMessage[]

  @@map("users")
}

enum DraftStatus {
  PENDING
  ACTIVE
  COMPLETE
}

model Season {
  year             Int         @id
  draftStatus      DraftStatus @default(PENDING) @map("draft_status")
  pickClockSeconds Int         @default(90) @map("pick_clock_seconds")
  // Set when the current pick went on the clock; clients derive remaining time
  currentPickStartedAt DateTime? @map("current_pick_started_at")

  rosterSpots RosterSpot[]
  draftSlots  DraftSlot[]
  draftPicks  DraftPick[]
  messages    ChatMessage[]

  @@map("seasons")
}

// Draft order: slot 1..N per season. Snake order is derived (odd rounds
// ascending, even rounds descending).
model DraftSlot {
  id         String @id @default(uuid())
  seasonYear Int    @map("season_year")
  slot       Int
  userId     String @map("user_id")

  season Season @relation(fields: [seasonYear], references: [year], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([seasonYear, slot])
  @@unique([seasonYear, userId])
  @@map("draft_slots")
}

// One row per pick made in a draft. pickNumber is the overall pick (1..rounds*managers).
model DraftPick {
  id         String   @id @default(uuid())
  seasonYear Int      @map("season_year")
  pickNumber Int      @map("pick_number")
  userId     String   @map("user_id")
  teamId     Int      @map("team_id")
  teamName   String   @map("team_name")
  createdAt  DateTime @default(now()) @map("created_at")

  season Season @relation(fields: [seasonYear], references: [year], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([seasonYear, pickNumber])
  @@unique([seasonYear, teamId])
  @@map("draft_picks")
}

// Canonical roster: which manager owns which CFBD team for a season.
// Written as draft picks happen; seeded directly for pre-app seasons (2025).
// The [seasonYear, teamId] unique enforces league-wide exclusive ownership.
model RosterSpot {
  id         String @id @default(uuid())
  seasonYear Int    @map("season_year")
  userId     String @map("user_id")
  teamId     Int    @map("team_id")

  season Season @relation(fields: [seasonYear], references: [year], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([seasonYear, teamId])
  @@index([seasonYear, userId])
  @@map("roster_spots")
}

model ChatMessage {
  id         String   @id @default(uuid())
  seasonYear Int      @map("season_year")
  userId     String   @map("user_id")
  body       String
  createdAt  DateTime @default(now()) @map("created_at")

  season Season @relation(fields: [seasonYear], references: [year], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([seasonYear, createdAt])
  @@map("chat_messages")
}
