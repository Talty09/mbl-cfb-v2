# College Football Data API key (https://collegefootballdata.com/key)
CFBD_API_KEY=your_api_key_here

# Server port
PORT=3000

# PostgreSQL connection string (queries). Local: plain URL. Supabase: the
# pooled URL, e.g. postgresql://postgres.[ref]:[pw]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mbl_v2?schema=public"

# Direct (non-pooled) connection used by prisma migrate. Local: same as
# DATABASE_URL. Supabase: the direct URL on port 5432.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/mbl_v2?schema=public"

# Secret used to sign JWTs — generate a long random string for production
JWT_SECRET=dev-secret-change-me

# Password assigned to all seeded users (managers should change it later)
SEED_DEFAULT_PASSWORD=changeme

# Comma-separated origins allowed by CORS (client dev server by default)
CORS_ORIGINS=http://localhost:4200
